contract ProtocolCertificatePairRelations {
    @uint32 uint32 observed;

    @uint32 function receive(uint32 value) {
        observed += value;
    }

    @address function straight_line(
        uint32 first,
        uint32 second,
        uint32 value
    ) export {
        relay@first receive(value);
        relay@second receive(value);
    }

    @address function distinct_arithmetic(
        uint32 base,
        uint32 value
    ) export {
        relay@base receive(value);
        relay@(base + 1u32) receive(value);
    }

    @address function same_target(
        uint32 target,
        uint32 value
    ) export {
        relay@target receive(value);
        relay@target receive(value);
    }

    @address function exclusive(
        bool choose_first,
        uint32 first,
        uint32 second,
        uint32 value
    ) export {
        if (choose_first) {
            relay@first receive(value);
        } else {
            relay@second receive(value);
        }
    }
}
