    {
      "name": "KittyParallel",
      "source": "oxd_preda/simulator/contracts/Kitty.prd",
      "runtime_template": "fixtures/KittyParallel.prdts.in",
      "function_signature": "breed_parallel(address,address,address,bigint,bool)",
      "runtime_arguments": [
        "-seed:88",
        "-order:2",
        "-addresses:8"
      ],
      "runtime_coverage": {
        "required_function_signatures": [
          "breed_parallel(address,address,address,bigint,bool)"
        ],
        "required_semantic_sites": [
          "offspring",
          "parent1",
          "parent2"
        ],
        "unresolved_site_ids": []
      },
      "sites": {
        "offspring": {
          "source_function_signature": "breed_parallel(address,address,address,bigint,bool)",
          "target_text": "offspring",
          "relay_kind": "custom_scope",
          "target_scope": "address",
          "occurrence": 0
        },
        "parent1": {
          "source_function_signature": "breed_parallel(address,address,address,bigint,bool)",
          "target_text": "parent1",
          "relay_kind": "custom_scope",
          "target_scope": "address",
          "occurrence": 0
        },
        "parent2": {
          "source_function_signature": "breed_parallel(address,address,address,bigint,bool)",
          "target_text": "parent2",
          "relay_kind": "custom_scope",
          "target_scope": "address",
          "occurrence": 0
        }
      },
      "certificates": [
        {
          "id": "kitty.offspring_parent1.independence",
          "pattern": "offspring_parent_updates",
          "certificate_type": "CoEmissionIndependent",
          "site_a": "offspring",
          "site_b": "parent1",
          "expected_relation": "CoEmissionIndependent",
          "expected_status": "Proved",
          "mutation": {
            "kind": "IntroduceAlias",
            "sites": [
              "offspring",
              "parent1"
            ],
            "validation_required": true,
            "expected_regression_contains": "lost proved CoEmissionIndependent"
          }
        },
        {
          "id": "kitty.offspring_parent2.independence",
          "pattern": "offspring_parent_updates",
          "certificate_type": "CoEmissionIndependent",
          "site_a": "offspring",
          "site_b": "parent2",
          "expected_relation": "CoEmissionIndependent",
          "expected_status": "Proved",
          "mutation": {
            "kind": "IntroduceAlias",
            "sites": [
              "offspring",
              "parent2"
            ],
            "validation_required": true,
            "expected_regression_contains": "lost proved CoEmissionIndependent"
          }
        },
        {
          "id": "kitty.parent1_parent2.independence",
          "pattern": "offspring_parent_updates",
          "certificate_type": "CoEmissionIndependent",
          "site_a": "parent1",
          "site_b": "parent2",
          "expected_relation": "CoEmissionIndependent",
          "expected_status": "Proved",
          "mutation": {
            "kind": "IntroduceAlias",
            "sites": [
              "parent1",
              "parent2"
            ],
            "validation_required": true,
            "expected_regression_contains": "lost proved CoEmissionIndependent"
          }
        },
        {
          "id": "kitty.direct_work.bound",
          "pattern": "offspring_parent_updates",
          "certificate_type": "WorkBound",
          "bound_field": "direct_logical_work",
          "expected_status": "Proved",
          "expected_upper_bound": 3,
          "mutation": {
            "kind": "RelayDuplicate",
            "sites": [
              "offspring"
            ],
            "validation_required": true,
            "expected_regression_contains": "certificate bound increased"
          }
        },
        {
          "id": "kitty.transitive_work.bound",
          "pattern": "offspring_parent_updates",
          "certificate_type": "WorkBound",
          "bound_field": "transitive_logical_work",
          "expected_status": "Proved",
          "expected_upper_bound": 3,
          "mutation": {
            "kind": "PositiveOnly",
            "validation_required": false,
            "reason": "The RelayDuplicate validation is owned by the direct-work record; this record is retained as positive bound evidence."
          }
        },
        {
          "id": "kitty.physical_work.bound",
          "pattern": "offspring_parent_updates",
          "certificate_type": "WorkBound",
          "bound_field": "physical_route_work",
          "expected_status": "Proved",
          "expected_upper_bound": 3,
          "mutation": {
            "kind": "PositiveOnly",
            "validation_required": false,
            "reason": "The RelayDuplicate validation is owned by the direct-work record; this record is retained as positive bound evidence."
          }
        },
        {
          "id": "kitty.depth.bound",
          "pattern": "offspring_parent_updates",
          "certificate_type": "DepthBound",
          "bound_field": "relay_tree_depth",
          "expected_status": "Proved",
          "expected_upper_bound": 1,
          "mutation": {
            "kind": "PositiveOnly",
            "validation_required": false,
            "reason": "RelayDuplicate changes work but does not increase sibling relay-tree depth, so no false depth violation is claimed."
          }
        }
      ]
