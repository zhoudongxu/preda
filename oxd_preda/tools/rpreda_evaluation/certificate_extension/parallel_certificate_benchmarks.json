{
  "schema_version": 1,
  "study": "parallel_certificate_extension",
  "aggregate_with_original_coverage": false,
  "output_subdirectory": "certificate_extension",
  "defaults": {
    "seed": 88,
    "order": 2,
    "addresses": 8,
    "timeout_seconds": 60,
    "strict_runtime_validation": true,
    "site_resolution": "semantic_locator_only"
  },
  "benchmarks": [
    {
      "name": "TokenParallel",
      "source": "oxd_preda/simulator/contracts/Token.prd",
      "runtime_template": "fixtures/TokenParallel.prdts.in",
      "function_signature": "transfer_parallel(address,address,bigint)",
      "runtime_arguments": [
        "-seed:88",
        "-order:2",
        "-addresses:8"
      ],
      "runtime_coverage": {
        "required_function_signatures": [
          "transfer_parallel(address,address,bigint)"
        ],
        "required_semantic_sites": [
          "recipient",
          "audit"
        ],
        "unresolved_site_ids": []
      },
      "sites": {
        "recipient": {
          "source_function_signature": "transfer_parallel(address,address,bigint)",
          "target_text": "to",
          "target_function": "parallel_deposit",
          "relay_kind": "custom_scope",
          "target_scope": "address",
          "occurrence": 0
        },
        "audit": {
          "source_function_signature": "transfer_parallel(address,address,bigint)",
          "target_text": "audit",
          "target_function": "parallel_record_audit",
          "relay_kind": "custom_scope",
          "target_scope": "address",
          "occurrence": 0
        }
      },
      "certificates": [
        {
          "id": "token.receiver_audit.independence",
          "pattern": "receiver_audit",
          "certificate_type": "CoEmissionIndependent",
          "site_a": "recipient",
          "site_b": "audit",
          "expected_relation": "CoEmissionIndependent",
          "expected_status": "Proved",
          "mutation": {
            "kind": "IntroduceAlias",
            "sites": [
              "recipient",
              "audit"
            ],
            "validation_required": true,
            "expected_regression_contains": "lost proved CoEmissionIndependent"
          }
        },
        {
          "id": "token.receiver_audit.precedence",
          "pattern": "receiver_audit",
          "certificate_type": "MustPrecede",
          "site_a": "recipient",
          "site_b": "audit",
          "expected_relation": "MustPrecedeAB",
          "expected_status": "Proved",
          "mutation": {
            "kind": "RelayOrderSwap",
            "sites": [
              "recipient",
              "audit"
            ],
            "validation_required": true,
            "expected_regression_contains": "precedence reversed"
          }
        }
      ]
    },
