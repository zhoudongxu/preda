// Deterministic CryptoKitties-style nested-relay fixture.
// Keep addresses == count so the generated kitty ID ranges remain valid.
random.reseed $~seed$
allocate.address $~addresses$
chain.gaslimit 256

chain.deploy @1 {{SOURCE}}

KittyBreeding.mint {
    genes:"$bigint.random(32)$",
    gender:true,
    owner:"$@all$"
}
chain.run

KittyBreeding.mint {
    genes:"$bigint.random(32)$",
    gender:false,
    owner:"$@all$"
}
chain.run

txn_breed[] = KittyBreeding.breed*$~count$ @random {
    m:$random(1, ~count-1)$,
    s:$random(~count+1, ~count*2-1)$,
    gender:false
}
chain.run

txn_register[] = KittyBreeding.registerNewBorns #all {}
chain.run
chain.info

viz.addr @all KittyBreeding
viz.shard #g KittyBreeding
viz.shard #all KittyBreeding
viz.block #g
viz.block #all
