// Deterministic Token fixture for R-PREDA runtime optimization A/B.
random.reseed $~seed$
allocate.address $~addresses$
chain.gaslimit 256

chain.deploy @1 ../../../contracts/Token.prd
state.set Token.address @all { balance:"10000000000000", auditTransfers:0, auditVolume:"0" }

txn_bench[] = Token.transfer*$~count$ @random {
    to:"$@random$",
    amount:"$random(1000, 2000)*100$"
}

stopwatch.restart
chain.run
stopwatch.report
chain.info

// Correctness-only state and block projections.
viz.addr @all Token
viz.block #g
viz.block #all
