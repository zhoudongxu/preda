random.reseed $~seed$
allocate.address $~addresses$
chain.gaslimit 65536

chain.deploy @1 ../../../contracts/Kitty.prd

txn_parallel[] = KittyBreeding.breed_parallel*$~count$ @random {
    offspring:"$@1$", parent1:"$@2$", parent2:"$@3$",
    genes:"123456789", gender:false
}

stopwatch.restart
chain.run
stopwatch.report
chain.info
