// Deterministic 100-recipient AirDrop timing fixture. No viz state queries.
random.reseed $~seed$
allocate.address $~addresses$
chain.gaslimit 256

chain.deploy @1 ../../../contracts/Token.prd
state.set Token.address @all { balance:"10000000000000" }

