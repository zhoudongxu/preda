// Deterministic CryptoKitties-style timing fixture. No viz state queries.
// Keep addresses == count so the generated kitty ID ranges stay valid.
random.reseed $~seed$
allocate.address $~addresses$
chain.gaslimit 256

chain.deploy @1 ../../../contracts/Kitty.prd

KittyBreeding.mint {
    genes:"$bigint.random(32)$",
    gender:true,
    owner:"$@all$"
}
chain.run

KittyBreeding.mint {
    genes:"$bigint.random(32)$",
    gender:false,
    owner:"$@all$"
}
chain.run

txn_bench[] = KittyBreeding.breed*$~count$ @random {
    m:$random(1, ~count-1)$,
    s:$random(~count+1, ~count*2-1)$,
    gender:false
}

stopwatch.restart
chain.run
stopwatch.report
chain.info

KittyBreeding.registerNewBorns #all {}
chain.run
chain.info
