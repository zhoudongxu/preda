// Deterministic, bounded fixture for R-PREDA runtime trace off/observe A/B.
// The production MillionPixel.prdts keeps its original 10,000 transaction
// workload; this fixture exposes state and executed blocks for invariance
// comparison without changing the contract.
random.reseed 88

allocate.address $~count$
chain.gaslimit 256

chain.deploy @0 MillionPixel.prd

MillionPixel.occupy*$~count$ @random {
    x: $random(0, 7)$,
    y: $random(0, 7)$
}

stopwatch.restart
chain.run
stopwatch.report
chain.info

viz.uint_scope #32 MillionPixel:all
viz.block #g
viz.block #all
